{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Lukas",
  "version": "1.1.0",
  "identifier": "com.jvps.lukas",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "vite build --base=/",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lukas 1.0 — Simulador Clínico Realista (by Jvps)",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQ0M5M0Y3Rjc5MTc2OEQKUldTTmRwSDM5NVBNOGZpQXEwTm9Kck1qVHlXTE5IS1daRnlhaWp0K0Q1RW91ZDhTSHlRVGFpNzMK",
      "endpoints": [
        "https://github.com/chevalierjvps/lukas-simulator/releases/latest/download/latest.json"
      ]
    }
  }
}
